    <!-- JS Logic -->
    <script>
        let studentsMaster = []; 
        let isAdmin = false; 

        window.onload = () => {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('checkDate').value = today;
            document.getElementById('reportDate').value = today;
            checkDBConnection();
            loadStudentsData();
        };

        // ---------------------------------------------
        // SweetAlert2 - Loading & DB Status
        // ---------------------------------------------
        const showLoading = (msg = 'กำลังประมวลผล...') => {
            Swal.fire({
                title: msg,
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => { Swal.showLoading(); }
            });
        }
        
        const hideLoading = () => Swal.close();

        function checkDBConnection() {
            google.script.run.withSuccessHandler(res => {
                const badge = document.getElementById('dbStatusBadge');
                const dot = document.getElementById('dbStatusDot');
                const text = document.getElementById('dbStatusText');
                
                badge.classList.remove('hidden');
                
                if (res.status === 'success') {
                    badge.classList.add('bg-emerald-50', 'border-emerald-200');
                    dot.innerHTML = `<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>`;
                    text.classList.replace('text-amber-600', 'text-emerald-700');
                    text.innerText = 'DB Connected';
                } else {
                    badge.classList.add('bg-rose-50', 'border-rose-200');
                    dot.innerHTML = `<span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>`;
                    text.classList.replace('text-amber-600', 'text-rose-700');
                    text.innerText = 'DB Error';
                }
            }).checkDatabaseConnection();
        }

        // ---------------------------------------------
        // ระบบ Admin Login (ใช้ SweetAlert)
        // ---------------------------------------------
        function toggleAdmin() {
            if (isAdmin) {
                isAdmin = false;
                const btn = document.getElementById('adminBtn');
                btn.innerHTML = '🔒 เข้าสู่ระบบ Admin';
                btn.className = "bg-sky-50 hover:bg-sky-100 text-sky-700 px-4 py-2 rounded-lg text-sm font-medium transition border border-sky-200 shadow-sm flex items-center gap-2";
                
                document.querySelectorAll('.admin-only').forEach(el => el.classList.add('hidden'));
                switchTab('tab-report-daily');
            } else {
                Swal.fire({
                    title: 'เข้าสู่ระบบผู้ดูแล',
                    input: 'password',
                    inputPlaceholder: 'กรุณาใส่รหัสผ่าน...',
                    showCancelButton: true,
                    confirmButtonText: 'เข้าสู่ระบบ',
                    cancelButtonText: 'ยกเลิก',
                    confirmButtonColor: '#0284c7',
                }).then((result) => {
                    if (result.isConfirmed) {
                        if (result.value === '1234') { 
                            isAdmin = true;
                            const btn = document.getElementById('adminBtn');
                            btn.innerHTML = '🔓 ออกจากระบบ';
                            btn.className = "bg-rose-50 hover:bg-rose-100 text-rose-700 px-4 py-2 rounded-lg text-sm font-medium transition border border-rose-200 shadow-sm flex items-center gap-2";
                            
                            document.querySelectorAll('.admin-only').forEach(el => el.classList.remove('hidden'));
                            switchTab('tab-check');
                            Swal.fire({ icon: 'success', title: 'เข้าสู่ระบบสำเร็จ', showConfirmButton: false, timer: 1200 });
                        } else {
                            Swal.fire({ icon: 'error', title: 'รหัสผ่านไม่ถูกต้อง', confirmButtonColor: '#0284c7' });
                        }
                    }
                });
            }
        }

        function switchTab(tabId) {
            if ((tabId === 'tab-check' || tabId === 'tab-manage') && !isAdmin) return Swal.fire({ icon: 'warning', title: 'ฟีเจอร์นี้สำหรับ Admin เท่านั้น', confirmButtonColor: '#0284c7' });

            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('tab-active');
                el.classList.add('tab-inactive');
            });
            
            document.getElementById(tabId).classList.remove('hidden');
            const activeBtn = document.getElementById(`btn-${tabId}`);
            activeBtn.classList.remove('tab-inactive');
            activeBtn.classList.add('tab-active');

            if(tabId === 'tab-report-daily') loadDailyReport();
            if(tabId === 'tab-check') loadChecklist();
        }

        // ---------------------------------------------
        // จัดการนักเรียน & ดึงข้อมูลพื้นฐาน
        // ---------------------------------------------
        function loadStudentsData() {
            showLoading('กำลังโหลดข้อมูลฐานข้อมูล...');
            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if (res.status === 'success') {
                    studentsMaster = res.data;
                    renderManageStudents();
                    updatePersonDropdown();
                    loadDailyReport();
                } else { 
                    Swal.fire({ icon: 'error', title: 'เกิดข้อผิดพลาด', text: res.message }); 
                }
            }).getStudents();
        }

        function updatePersonDropdown() {
            const select = document.getElementById('personSelect');
            select.innerHTML = '<option value="">-- กรุณาเลือกนักเรียน --</option>';
            studentsMaster.forEach(s => {
                select.innerHTML += `<option value="${s.name}">เลขที่ ${s.no}. ${s.name}</option>`;
            });
        }

        function renderManageStudents() {
            const tbody = document.getElementById('studentTbody');
            tbody.innerHTML = '';
            if (studentsMaster.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-slate-400">ยังไม่มีข้อมูลนักเรียน</td></tr>`;
                return;
            }
            studentsMaster.forEach(s => {
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50">
                        <td class="px-6 py-3 text-center text-slate-600">${s.no}</td>
                        <td class="px-6 py-3 text-slate-500">${s.id}</td>
                        <td class="px-6 py-3 text-slate-800">${s.name}</td>
                        <td class="px-6 py-3 text-center">
                            <button onclick="removeStudent(${s.rowIndex}, '${s.name}')" class="text-rose-500 hover:text-white bg-rose-50 hover:bg-rose-500 px-3 py-1.5 rounded-md text-xs font-medium transition border border-rose-100">ลบข้อมูล</button>
                        </td>
                    </tr>
                `;
            });
        }

        function addStudentData(e) {
            e.preventDefault();
            const student = {
                no: document.getElementById('stuNo').value,
                id: document.getElementById('stuId').value,
                name: document.getElementById('stuName').value
            };
            showLoading('กำลังสร้างฐานข้อมูลให้นักเรียนใหม่...');
            google.script.run.withSuccessHandler(res => {
                if (res.status === 'success') {
                    document.getElementById('addStudentForm').reset();
                    Swal.fire({ icon: 'success', title: 'เพิ่มนักเรียนสำเร็จ', text: 'สร้างชีทข้อมูลส่วนตัวเรียบร้อยแล้ว', timer: 2000, showConfirmButton: false });
                    loadStudentsData();
                } else { hideLoading(); Swal.fire({ icon: 'error', title: 'ผิดพลาด', text: res.message }); }
            }).addStudent(student);
        }

        function removeStudent(rowIndex, name) {
            Swal.fire({
                title: 'ยืนยันการลบข้อมูล?',
                text: `คุณต้องการลบข้อมูลของ ${name} ใช่หรือไม่? (ชีทประวัติจะถูกลบทิ้งถาวร)`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'ใช่, ลบทิ้ง!',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    showLoading('กำลังลบข้อมูลและชีทประวัติ...');
                    google.script.run.withSuccessHandler(res => {
                        if (res.status === 'success') {
                            Swal.fire({ icon: 'success', title: 'ลบข้อมูลสำเร็จ', showConfirmButton: false, timer: 1500 });
                            loadStudentsData();
                        } else { 
                            hideLoading(); 
                            Swal.fire({ icon: 'error', title: 'ผิดพลาด', text: res.message }); 
                        }
                    }).deleteStudent(rowIndex, name);
                }
            });
        }

        // ---------------------------------------------
        // ระบบเช็คชื่อ (ADMIN)
        // ---------------------------------------------
        function loadChecklist() {
            const date = document.getElementById('checkDate').value;
            const tbody = document.getElementById('checkTbody');
            
            if(studentsMaster.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" class="text-center py-8 text-slate-400">ยังไม่มีข้อมูลนักเรียน กรุณาเพิ่มรายชื่อก่อน</td></tr>`;
                return;
            }

            showLoading('กำลังเตรียมหน้าเช็คชื่อ...');
            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if(res.status === 'success') {
                    tbody.innerHTML = '';
                    res.data.forEach(s => {
                        const status = s.status || 'มา'; 
                        const createRadio = (val, activeClass) => `
                            <label class="cursor-pointer">
                                <input type="radio" name="st_${s.id}" value="${val}" class="peer sr-only" ${status===val ? 'checked' : ''}>
                                <div class="w-14 md:w-16 text-center py-2 rounded-xl text-sm font-semibold border border-slate-200 text-slate-500 bg-white hover:bg-slate-50 transition-all duration-200 shadow-sm peer-checked:border-transparent ${activeClass}">
                                    ${val}
                                </div>
                            </label>
                        `;

                        tbody.innerHTML += `
                            <tr class="hover:bg-sky-50/30 border-b border-slate-50 last:border-0">
                                <td class="px-4 py-4 text-center text-slate-600">${s.no}</td>
                                <td class="px-4 py-4 font-medium text-slate-800" data-name="${s.name}">${s.name}</td>
                                <td class="px-4 py-4">
                                    <div class="flex justify-center md:justify-start gap-2 md:gap-3">
                                        ${createRadio('มา', 'peer-checked:bg-emerald-500 peer-checked:text-white peer-checked:shadow-md peer-checked:shadow-emerald-200')}
                                        ${createRadio('ขาด', 'peer-checked:bg-rose-500 peer-checked:text-white peer-checked:shadow-md peer-checked:shadow-rose-200')}
                                        ${createRadio('ลา', 'peer-checked:bg-amber-500 peer-checked:text-white peer-checked:shadow-md peer-checked:shadow-amber-200')}
                                        ${createRadio('มาสาย', 'peer-checked:bg-orange-500 peer-checked:text-white peer-checked:shadow-md peer-checked:shadow-orange-200')}
                                    </div>
                                </td>
                            </tr>
                        `;
                    });
                } else { Swal.fire({ icon: 'error', title: 'ผิดพลาด', text: res.message }); }
            }).getDailyAttendance(date);
        }

        function submitAttendance() {
            const date = document.getElementById('checkDate').value;
            if (!date) return Swal.fire({ icon: 'warning', title: 'กรุณาเลือกวันที่ก่อนบันทึก' });

            const records = [];
            const rows = document.querySelectorAll('#checkTbody tr');
            
            rows.forEach(tr => {
                if(tr.cells.length < 3) return;
                const idInput = tr.querySelector('input[type="radio"]');
                if(!idInput) return;
                
                const name = tr.cells[1].getAttribute('data-name');
                const st_name = idInput.name; 
                const statusElement = document.querySelector(`input[name="${st_name}"]:checked`);
                
                if(statusElement && name) {
                     records.push({ name: name, status: statusElement.value });
                }
            });

            if (records.length === 0) return Swal.fire({ icon: 'info', title: 'ไม่มีข้อมูลนักเรียนให้บันทึก' });

            showLoading('กำลังบันทึกข้อมูลเข้าสู่ฐานข้อมูลหลัก...');
            google.script.run.withSuccessHandler(res => {
                if (res.status === 'success') {
                    Swal.fire({ icon: 'success', title: 'บันทึกสำเร็จ!', text: 'อัปเดตข้อมูลการมาเรียนเรียบร้อยแล้ว', confirmButtonColor: '#0284c7' });
                } else {
                    Swal.fire({ icon: 'error', title: 'บันทึกไม่สำเร็จ', text: res.message });
                }
            }).saveAttendance(date, records);
        }

        // ---------------------------------------------
        // จัดการแก้วันที่ (Move Date)
        // ---------------------------------------------
        function openEditDateModal() {
            document.getElementById('oldDateInput').value = document.getElementById('checkDate').value;
            document.getElementById('newDateInput').value = '';
            document.getElementById('editDateModal').classList.remove('hidden');
        }

        function closeEditDateModal() {
            document.getElementById('editDateModal').classList.add('hidden');
        }

        function submitEditDate() {
            const oldDate = document.getElementById('oldDateInput').value;
            const newDate = document.getElementById('newDateInput').value;

            if (!oldDate || !newDate) return Swal.fire('แจ้งเตือน', 'กรุณาระบุวันที่ให้ครบถ้วน', 'warning');
            if (oldDate === newDate) return Swal.fire('แจ้งเตือน', 'วันที่เดิมและวันที่ใหม่ซ้ำกัน', 'warning');

            Swal.fire({
                title: 'ยืนยันการย้ายข้อมูล?',
                text: `ย้ายข้อมูลจากวันที่ ${formatDate(oldDate)} ไปยัง ${formatDate(newDate)}`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0284c7',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'ใช่, ย้ายเลย',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    closeEditDateModal();
                    showLoading('กำลังย้ายข้อมูลข้ามวัน...');

                    google.script.run.withSuccessHandler(res => {
                        if (res.status === 'success') {
                            Swal.fire('สำเร็จ!', res.message, 'success');
                            document.getElementById('checkDate').value = newDate;
                            loadChecklist(); 
                        } else {
                            Swal.fire('เกิดข้อผิดพลาด', res.message, 'error');
                        }
                    }).editAttendanceDate(oldDate, newDate);
                }
            });
        }

        // ---------------------------------------------
        // รายงานรายวัน & รายบุคคล
        // ---------------------------------------------
        function loadDailyReport() {
            const date = document.getElementById('reportDate').value;
            document.getElementById('daily-report-date-text').innerText = 'วันที่: ' + (date ? formatDate(date) : '-');
            
            showLoading('กำลังโหลดรายงาน...');
            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if(res.status === 'success') {
                    const tbody = document.getElementById('dailyReportTbody');
                    tbody.innerHTML = '';
                    let counts = { 'มา':0, 'ขาด':0, 'ลา':0, 'มาสาย':0 };
                    let hasData = false;

                    res.data.forEach(a => {
                        if(a.status) { 
                            hasData = true;
                            counts[a.status]++;
                            let sColor = a.status=='มา'?'text-emerald-600 bg-emerald-50 border-emerald-100': 
                                         a.status=='ขาด'?'text-rose-600 bg-rose-50 border-rose-100': 
                                         a.status=='ลา'?'text-amber-600 bg-amber-50 border-amber-100':
                                         'text-orange-600 bg-orange-50 border-orange-100';

                            tbody.innerHTML += `
                                <tr class="hover:bg-slate-50">
                                    <td class="px-4 py-3 text-center text-slate-600">${a.no}</td>
                                    <td class="px-4 py-3 text-slate-500">${a.id}</td>
                                    <td class="px-4 py-3 font-medium text-slate-800">${a.name}</td>
                                    <td class="px-4 py-3 text-center">
                                        <span class="px-3 py-1 rounded-full text-xs font-bold border ${sColor}">${a.status}</span>
                                    </td>
                                </tr>
                            `;
                        }
                    });

                    if(!hasData) tbody.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-slate-400">ยังไม่มีข้อมูลการมาเรียนในวันนี้</td></tr>`;

                    document.getElementById('sum-present').innerText = counts['มา'] || 0;
                    document.getElementById('sum-absent').innerText = counts['ขาด'] || 0;
                    document.getElementById('sum-leave').innerText = counts['ลา'] || 0;
                    document.getElementById('sum-late').innerText = counts['มาสาย'] || 0;
                } else { Swal.fire('ผิดพลาด', res.message, 'error'); }
            }).getDailyAttendance(date);
        }

        function loadPersonReport() {
            const studentName = document.getElementById('personSelect').value;
            const tbody = document.getElementById('personReportTbody');
            
            if (!studentName) {
                document.getElementById('person-name-text').innerText = 'กรุณาเลือกนักเรียน';
                ['present','absent','leave','late'].forEach(id => document.getElementById(`p-sum-${id}`).innerText = '0');
                tbody.innerHTML = '';
                return;
            }

            const sInfo = studentsMaster.find(s => s.name === studentName);
            document.getElementById('person-name-text').innerText = `เลขที่ ${sInfo.no} | รหัส: ${sInfo.id} | ${studentName}`;

            showLoading('กำลังดึงข้อมูลประวัติ...');
            google.script.run.withSuccessHandler(res => {
                hideLoading();
                if(res.status === 'success') {
                    tbody.innerHTML = '';
                    let counts = { 'มา':0, 'ขาด':0, 'ลา':0, 'มาสาย':0 };

                    if (res.data.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="2" class="text-center py-6 text-slate-400">ไม่มีประวัติการเข้าเรียน</td></tr>`;
                    } else {
                        res.data.forEach(a => {
                            counts[a.status]++;
                            let sColor = a.status=='มา'?'text-emerald-600 bg-emerald-50 border-emerald-100': 
                                         a.status=='ขาด'?'text-rose-600 bg-rose-50 border-rose-100': 
                                         a.status=='ลา'?'text-amber-600 bg-amber-50 border-amber-100':
                                         'text-orange-600 bg-orange-50 border-orange-100';
                                         
                            tbody.innerHTML += `
                                <tr class="hover:bg-slate-50">
                                    <td class="px-4 py-3 text-slate-600 font-medium">${formatDate(a.date)}</td>
                                    <td class="px-4 py-3 text-center">
                                        <span class="px-3 py-1 rounded-full text-xs font-bold border ${sColor}">${a.status}</span>
                                    </td>
                                </tr>
                            `;
                        });
                    }

                    document.getElementById('p-sum-present').innerText = counts['มา'] || 0;
                    document.getElementById('p-sum-absent').innerText = counts['ขาด'] || 0;
                    document.getElementById('p-sum-leave').innerText = counts['ลา'] || 0;
                    document.getElementById('p-sum-late').innerText = counts['มาสาย'] || 0;
                } else { Swal.fire('ผิดพลาด', res.message, 'error'); }
            }).getPersonAttendance(studentName);
        }

        // ---------------------------------------------
        // Utilities
        // ---------------------------------------------
        function formatDate(dateString) {
            if(!dateString) return '';
            const d = new Date(dateString);
            return d.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });
        }

        function exportToPDF(elementId, filename) {
            const element = document.getElementById(elementId);
            const opt = {
                margin:       0.5,
                filename:     filename + '.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
</body>
</html>
